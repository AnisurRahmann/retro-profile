{
  "name": "arshakil",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-knowledge.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "knowledge": "tsx scripts/build-knowledge.ts",
    "shots": "tsx scripts/shots.ts",
    "e2e": "pnpm build:e2e && playwright test",
    "eval:live": "tsx evals/run.ts --live",
    "eval:mock": "tsx evals/run.ts",
    "postbuild": "tsx scripts/check-build-output.ts",
    "test:build": "pnpm build && vitest run tests/build",
    "build:e2e": "tsx scripts/build-knowledge.ts && NEXT_PUBLIC_E2E=1 NEXT_DIST_DIR=.next-e2e next build",
    "e2e:only": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "suncalc": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
