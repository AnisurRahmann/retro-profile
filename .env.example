# Copy to .env.local. Never commit real values.
ANTHROPIC_API_KEY=
# Default: claude-haiku-5-5
CHAT_MODEL=claude-haiku-5-5
# false = /chat shows only the book-a-call card and email
CHAT_ENABLED=true
CHAT_DAILY_TOKEN_BUDGET=2000000
# Long random string; salts the IP hash used for rate limits
RATE_SALT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INTRO_NOTIFY_EMAIL=
INTRO_FROM_EMAIL=
